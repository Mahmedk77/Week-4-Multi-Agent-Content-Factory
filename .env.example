# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.

# --- LLMs ---
# Groq is currently disabled in src/graph/model.ts (free-tier rate limits); OpenAI is used for every call.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Search ---
TAVILY_API_KEY=

# --- Tracing (LangSmith) ---
# Same names as week-2. Which ones LangSmith actually needs is verified
# empirically in session 1 (see report).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=content-factory

# --- Site lock ---
# Passcode for the whole site (pages + API). Use a long random value in production.
# Not set: open in local dev, fully locked in production. Changing it logs every browser out.
SITE_PASSCODE=

# --- Supabase (server only: never prefix these with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler, port 5432 (not the transaction pooler on 6543). Used by the LangGraph checkpointer.
SUPABASE_DB_URL=
